<script>
  // Script Interativo para Troca de Conteúdo nas Abas do Dossiê Técnico
  function initDossieTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-dossie-tab]');
    const badge1 = document.getElementById('tab-badge-1');
    const desc1 = document.getElementById('tab-desc-1');
    const badge2 = document.getElementById('tab-badge-2');
    const desc2 = document.getElementById('tab-desc-2');
    const badge3 = document.getElementById('tab-badge-3');
    const desc3 = document.getElementById('tab-desc-3');

    const contentMap: Record<string, {
      b1: string; d1: string;
      b2: string; d2: string;
      b3: string; d3: string;
    }> = {
      fm: {
        b1: 'Prazo Peremptório',
        d1: 'Requerimento obrigatório nos 12 meses anteriores ao vencimento (Lei 5.785/72).',
        b2: 'Fiscalização Anatel',
        d2: 'Transmissor homologado, tolerância de espúrios e defesa tempestiva de PADO.',
        b3: 'SEI / MCom',
        d3: 'Homologação de alterações contratuais, diretoria e certidões no Ministério.'
      },
      radcom: {
        b1: 'Editais PNO',
        d1: 'Acompanhamento do cronograma federal e habilitação documental sem indeferimento.',
        b2: 'Potência 25W ERP',
        d2: 'Controle rigoroso da altura do sistema irradiante e filtro de harmônicos.',
        b3: 'Atas em Cartório',
        d3: 'Averbação de estatutos, atas de eleição e atualização de dirigentes no CADSE.'
      },
      tv: {
        b1: 'Digitalização TVD',
        d1: 'Regularização do canal digital e proteção contra perecimento de outorga.',
        b2: 'Estudo de Cobertura',
        d2: 'Laudos de viabilidade técnica para RTV primária e retransmissoras secundárias.',
        b3: 'Decreto Presidencial',
        d3: 'Acompanhamento da renovação com trâmite no Congresso Nacional e Diário Oficial.'
      }
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const type = tab.dataset.dossieTab || 'fm';

        tabs.forEach(t => {
          t.classList.remove('bg-blue-600', 'text-white', 'shadow-sm', 'border-t', 'border-white/25');
          t.classList.add('text-slate-400', 'hover:text-white', 'hover:bg-white/5');
        });

        tab.classList.add('bg-blue-600', 'text-white', 'shadow-sm', 'border-t', 'border-white/25');
        tab.classList.remove('text-slate-400', 'hover:text-white', 'hover:bg-white/5');

        const data = contentMap[type];
        if (data && badge1 && desc1 && badge2 && desc2 && badge3 && desc3) {
          badge1.textContent = data.b1;
          desc1.textContent = data.d1;
          badge2.textContent = data.b2;
          desc2.textContent = data.d2;
          badge3.textContent = data.b3;
          desc3.textContent = data.d3;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initDossieTabs);
  initDossieTabs();
</script>
