---
import Layout from '../layouts/Layout.astro';
import CardUrgencia from '../components/CardUrgencia.astro';
import { CONTACT_INFO } from '../config';

const whatsappUrl = `https://wa.me/${CONTACT_INFO.whatsapp}?text=Ol%C3%A1%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20assessoria%20regulat%C3%B3ria%20para%20minha%20emissora.`;
---

<Layout 
  title="IMEA Radiodifusão | Renovações de outorga e regulação"
  description="Consultoria técnica e jurídica perante MCom e Anatel para renovação de outorgas, defesas de PADO, migração e rádio comunitária em todo o Brasil."
  videoUrl="/videos/7087636-hd_1366_720_25fps.mp4"
>

  <!-- Hero Section: Autoridade Máxima, Alta Conversão & Imersão Cinematográfica -->
  <section class="relative bg-gradient-to-b from-[#06090e]/70 via-[#06090e]/45 to-[#06090e] -mt-24 pt-32 pb-20 sm:pt-36 sm:pb-28 lg:pt-40 lg:pb-32 overflow-hidden border-b border-white/[0.08]">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 relative z-10">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Bloco Principal de Apresentação e Conversão -->
        <div class="lg:col-span-7 space-y-6 text-white">
          
          <!-- Badge de Credibilidade Regulatória Editorial (Camada 5) -->
          <div class="editorial-eyebrow editorial-eyebrow-dark text-blue-300 border-blue-500/25">
            <span class="telemetry-dot bg-blue-400"></span>
            <span>Assessoria Regulatória Especializada • Desde 2003</span>
          </div>

          <!-- Headline Editorial de Alto Impacto com Gradientes Líquidos Platina & Ciano -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.08] text-balance">
            <span class="title-liquid-platinum block">Segurança Jurídica e Regularidade para sua</span>
            <span class="title-liquid-cyan block mt-1.5">Emissora de Rádio e TV</span>
          </h1>

          <!-- Descrição de Autoridade com Foco na Solução -->
          <p class="text-base sm:text-lg md:text-xl text-slate-200 leading-relaxed font-normal max-w-2xl drop-shadow-sm text-pretty">
            Atuamos diretamente junto ao <strong class="text-white font-semibold">Ministério das Comunicações (MCom)</strong> e à <strong class="text-white font-semibold">Anatel</strong> para garantir renovações de outorga sem risco de extinção, defesas tempestivas contra multas e gestão societária impecável.
          </p>

          <!-- Métricas de Confiança em Grade Rápida -->
          <div class="grid grid-cols-3 gap-2 sm:gap-6 py-2.5 border-y border-white/10 max-w-xl font-mono">
            <div class="space-y-0.5 min-w-0">
              <span class="block text-lg sm:text-2xl lg:text-3xl font-black text-white tracking-tight">+20 Anos</span>
              <p class="text-[10px] sm:text-xs text-slate-300 uppercase tracking-wider">de experiência técnica</p>
            </div>
            <div class="space-y-0.5 min-w-0">
              <span class="block text-lg sm:text-2xl lg:text-3xl font-black text-cyan-400 tracking-tight">100%</span>
              <p class="text-[10px] sm:text-xs text-slate-300 uppercase tracking-wider">Foco Regulatório</p>
            </div>
            <div class="space-y-0.5 min-w-0">
              <span class="block text-lg sm:text-2xl lg:text-3xl font-black text-blue-400 tracking-tight">Centenas</span>
              <p class="text-[10px] sm:text-xs text-slate-300 uppercase tracking-wider">de Outorgas Salvas</p>
            </div>
          </div>

          <!-- Selos de Telemetria Regulatória Federal com Radar Pulsante (Camada 5) -->
          <div class="flex flex-wrap items-center gap-2.5 pt-1">
            <div class="telemetry-badge telemetry-badge-dark text-emerald-300 border-emerald-500/30">
              <span class="telemetry-dot bg-emerald-400"></span>
              <span>SEI / CADSE • MCom Ativo</span>
            </div>
            <div class="telemetry-badge telemetry-badge-dark text-blue-300 border-blue-500/30">
              <span class="telemetry-dot bg-blue-400"></span>
              <span>Anatel PADO • Defesa Tempestiva</span>
            </div>
            <div class="telemetry-badge telemetry-badge-dark text-cyan-300 border-cyan-500/30">
              <span class="telemetry-dot bg-cyan-400"></span>
              <span>CREA / ART • 100% Homologado</span>
            </div>
          </div>

          <!-- Ações Principais com Iconografia e Total Prevenção de Quebra de Linha (Shimmer & Magnetic Integrados) -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a 
              href="/diagnostico-inicial" 
              data-magnetic
              data-umami-event="Diagnóstico — Hero Home"
              class="btn-shimmer-auto inline-flex items-center justify-center gap-2.5 sm:gap-3 bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs sm:text-sm md:text-base uppercase tracking-wider px-5 sm:px-7 md:px-8 py-3.5 sm:py-4 rounded-2xl shadow-glow-blue transition-all duration-300 transform hover:-translate-y-1 text-center whitespace-nowrap group shrink-0 border-t border-white/25"
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-cyan-300 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <span>Diagnóstico Inicial Sem Custo</span>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>

            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              data-magnetic
              data-umami-event="WhatsApp — Hero Home"
              class="btn-shimmer inline-flex items-center justify-center gap-2.5 sm:gap-3 bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold text-xs sm:text-sm md:text-base px-5 sm:px-7 md:px-8 py-3.5 sm:py-4 rounded-2xl backdrop-blur-md transition-all duration-300 text-center whitespace-nowrap group shrink-0"
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-emerald-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"/>
              </svg>
              <span>Falar no WhatsApp</span>
            </a>
          </div>

        </div>

        <!-- Painel Técnico Interativo / Dossiê (Lado Direito do Hero) com Camada 4 Spotlight e Camada 6 Tilt -->
        <div class="lg:col-span-5">
          <div class="relative rounded-2xl p-0.5 bg-gradient-to-b from-white/35 via-blue-500/25 to-indigo-500/15 shadow-2xl">
            <div 
              class="dossie-panel rounded-[15px] p-4 sm:p-5 bg-gradient-to-b from-[#0e1422] to-[#070b13] border-t border-white/30 border-x border-white/10 border-b border-white/5 backdrop-blur-2xl text-white space-y-3 relative overflow-hidden shadow-[inset_0_1px_1px_rgba(255,255,255,0.18)]"
              data-spotlight="blue"
              data-tilt
              data-tilt-max="3"
            >
              
              <!-- Fundo sutil de ambientação laser/glow -->
              <div class="absolute -right-16 -top-16 w-48 h-48 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>

              <!-- Cabeçalho Institucional do Dossiê -->
              <div class="relative z-10 border-b border-white/10 pb-2.5 space-y-1">
                <div class="flex items-center justify-between">
                  <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-blue-500/15 border border-blue-400/30 text-blue-300 font-mono text-[10px] font-bold uppercase tracking-wider backdrop-blur-md shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
                    Dossiê Técnico Regulatório
                  </div>
                  <span class="text-[10px] font-mono text-emerald-400 flex items-center gap-1 font-bold">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Vigência 2026
                  </span>
                </div>

                <div class="flex items-baseline justify-between">
                  <h2 class="text-lg sm:text-xl font-black text-white tracking-tight">
                    Auditoria da Emissora
                  </h2>
                  <span class="text-[10px] font-mono text-slate-400">
                    MCom • Anatel • CADSE
                  </span>
                </div>
              </div>

              <!-- Seletor Interativo com Ícones de Segmento e Borda Especular -->
              <div class="dossie-tabs relative z-10 grid grid-cols-3 gap-1 p-0.5 bg-white/[0.04] rounded-xl border-t border-white/20 border-x border-white/10 border-b border-white/5 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]" id="dossie-tabs">
                <button 
                  type="button" 
                  data-dossie-tab="fm"
                  class="dossie-tab-btn inline-flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-lg text-[11px] font-bold transition-all text-center whitespace-nowrap bg-blue-600 text-white shadow-sm border-t border-white/25"
                >
                  <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/></svg>
                  <span>FM Comercial</span>
                </button>
                <button 
                  type="button" 
                  data-dossie-tab="radcom"
                  class="dossie-tab-btn inline-flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-lg text-[11px] font-bold transition-all text-center whitespace-nowrap text-slate-400 hover:text-white hover:bg-white/5"
                >
                  <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><circle cx="12" cy="12" r="2"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19.1"/></svg>
                  <span>Radcom</span>
                </button>
                <button 
                  type="button" 
                  data-dossie-tab="tv"
                  class="dossie-tab-btn inline-flex items-center justify-center gap-1.5 px-2 py-1.5 rounded-lg text-[11px] font-bold transition-all text-center whitespace-nowrap text-slate-400 hover:text-white hover:bg-white/5"
                >
                  <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
                  <span>TV & RTV</span>
                </button>
              </div>

              <!-- Blocos Dinâmicos do Dossiê -->
              <div class="relative z-10 space-y-2.5 pt-1" id="dossie-content">
                
                <!-- Bloco 1: Renovação de Outorga -->
                <div class="dossie-block p-3 rounded-xl bg-white/[0.04] border-t border-white/20 border-x border-white/10 border-b border-white/5 space-y-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]">
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-bold text-white flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      Renovação de Concessão
                    </span>
                    <span class="font-mono text-[10px] text-blue-400 font-bold bg-blue-500/10 px-1.5 py-0.5 rounded border border-blue-400/20" id="tab-badge-1">
                      Prazo Peremptório
                    </span>
                  </div>
                  <p class="text-[11px] text-slate-300 leading-relaxed font-normal" id="tab-desc-1">
                    Requerimento obrigatório nos 12 meses anteriores ao vencimento (Lei 5.785/72).
                  </p>
                </div>

                <!-- Bloco 2: Conformidade Técnica Anatel -->
                <div class="dossie-block p-3 rounded-xl bg-white/[0.04] border-t border-white/20 border-x border-white/10 border-b border-white/5 space-y-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]">
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-bold text-white flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                      Fiscalização & Parâmetros RF
                    </span>
                    <span class="font-mono text-[10px] text-cyan-400 font-bold bg-cyan-500/10 px-1.5 py-0.5 rounded border border-cyan-400/20" id="tab-badge-2">
                      Fiscalização Anatel
                    </span>
                  </div>
                  <p class="text-[11px] text-slate-300 leading-relaxed font-normal" id="tab-desc-2">
                    Transmissor homologado, tolerância de espúrios e defesa tempestiva de PADO.
                  </p>
                </div>

                <!-- Bloco 3: Quadro Societário e Jurídico -->
                <div class="dossie-block p-3 rounded-xl bg-white/[0.04] border-t border-white/20 border-x border-white/10 border-b border-white/5 space-y-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]">
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-bold text-white flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                      Quadro Societário & Atas
                    </span>
                    <span class="font-mono text-[10px] text-indigo-400 font-bold bg-indigo-500/10 px-1.5 py-0.5 rounded border border-indigo-400/20" id="tab-badge-3">
                      SEI / MCom
                    </span>
                  </div>
                  <p class="text-[11px] text-slate-300 leading-relaxed font-normal" id="tab-desc-3">
                    Homologação de alterações contratuais, diretoria e certidões no Ministério.
                  </p>
                </div>

              </div>

              <!-- Alerta Preventivo de Autoridade -->
              <div class="dossie-alert relative z-10 px-2.5 py-1.5 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center gap-2 text-[11px] text-amber-200">
                <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <span class="truncate">Regularização preventiva reduz em 90% o risco de autuação.</span>
              </div>

            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Bento Grid de Soluções com Camada 4 Spotlight & Camada 6 Tilt 3D -->
  <section class="py-20 sm:py-28 bg-white text-slate-900 relative">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 space-y-16">
      
      <!-- Cabeçalho da Seção -->
      <div class="max-w-3xl space-y-4" data-animate="fade-up">
        <div class="editorial-eyebrow editorial-eyebrow-light text-blue-700 bg-blue-50/90 border border-blue-200/80">
          <span class="telemetry-dot bg-blue-600"></span>
          <span>Portfólio de Serviços Regulatórios</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight text-balance">
          Soluções Especializadas para <span class="bg-gradient-to-r from-blue-600 via-cyan-600 to-indigo-600 bg-clip-text text-transparent">Concessionárias de Radiodifusão</span>
        </h2>
        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed text-pretty">
          Atendimento integrado em engenharia de radiofrequência e contencioso administrativo para garantir segurança e estabilidade operacional à sua emissora.
        </p>
      </div>

      <!-- Grid Bento Responsivo com Acabamento Especular, Spotlight e Tilt 3D Cinético -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
        
        <!-- Card 1: Renovação de Outorga (Destaque Span 2) -->
        <a 
          href="/solucoes/renovacao-de-outorga" 
          data-spotlight="blue"
          data-tilt
          data-tilt-max="3"
          class="group modern-card rounded-3xl p-8 sm:p-10 border-t-2 border-t-blue-500 border-x border-blue-200/80 border-b border-blue-200/60 bg-gradient-to-br from-blue-50/70 via-white to-slate-50 md:col-span-2 shadow-[0_1px_3px_rgba(15,23,42,0.03),0_12px_28px_-4px_rgba(15,23,42,0.05),inset_0_1px_0_rgba(255,255,255,1)] flex flex-col justify-between space-y-8 relative overflow-hidden transition-all hover:border-blue-400 hover:shadow-glow-blue/20"
        >
          <div class="space-y-4 relative z-10">
            <div class="flex items-center justify-between">
              <span class="telemetry-badge telemetry-badge-light text-blue-800 bg-blue-50 border border-blue-200/90">
                <span class="telemetry-dot bg-blue-600"></span>
                <span>Prazo Fatal • 12 Meses</span>
              </span>
              <span class="text-xs font-mono text-slate-500 font-semibold">MCom & CADSE</span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-black text-slate-900 group-hover:text-blue-600 transition-colors tracking-tight">
              Renovação de Outorga (Rádio e TV)
            </h3>

            <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-2xl font-normal">
              Evite o cancelamento da concessão ou permissão. Cuidamos da montagem rigorosa dos processos administrativos no CADSE e no SEI do Ministério das Comunicações dentro do prazo legal de 12 meses anteriores ao vencimento.
            </p>
          </div>

          <!-- Metodologia em 3 Passos no Card -->
          <div class="grid grid-cols-3 gap-4 pt-4 border-t border-blue-100 text-xs font-mono relative z-10">
            <div class="space-y-1">
              <span class="text-slate-500 block">Etapa 01</span>
              <strong class="text-slate-900 font-bold block">Auditoria CADSE</strong>
            </div>
            <div class="space-y-1">
              <span class="text-slate-500 block">Etapa 02</span>
              <strong class="text-slate-900 font-bold block">Laudos Anatel & ART</strong>
            </div>
            <div class="space-y-1">
              <span class="text-slate-500 block">Etapa 03</span>
              <strong class="text-blue-600 font-bold block">Decreto no DOU</strong>
            </div>
          </div>
        </a>

        <!-- Card 2: Defesa Administrativa Anatel (Alerta Vermelho) -->
        <a 
          href="/solucoes/defesa-administrativa-anatel" 
          data-spotlight="red"
          data-tilt
          data-tilt-max="3.5"
          class="group modern-card rounded-3xl p-8 border-t-2 border-t-red-500 border-x border-red-200/80 border-b border-red-200/60 bg-gradient-to-br from-red-50/50 via-white to-slate-50 shadow-[0_1px_3px_rgba(15,23,42,0.03),0_12px_28px_-4px_rgba(15,23,42,0.05),inset_0_1px_0_rgba(255,255,255,1)] relative overflow-hidden flex flex-col justify-between space-y-6 transition-all hover:border-red-400 hover:shadow-glow-red/20"
        >
          <div class="space-y-4 relative z-10">
            <div class="flex items-center justify-between">
              <span class="telemetry-badge telemetry-badge-light text-red-800 bg-red-50 border border-red-200/90">
                <span class="telemetry-dot bg-red-600"></span>
                <span>Contencioso Ativo</span>
              </span>
              <span class="text-xs font-mono text-slate-500 font-semibold">Anatel • PADO</span>
            </div>

            <h3 class="text-xl sm:text-2xl font-black text-slate-900 group-hover:text-red-600 transition-colors">
              Defesa Administrativa Anatel
            </h3>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
              Impugnação técnica de autos de infração, PADO e recursos contra multas por potência, antena fora de parâmetros ou falta de laudo de irradiação.
            </p>
          </div>

          <div class="pt-4 border-t border-slate-200 flex items-center justify-between text-xs font-mono font-bold text-red-600 whitespace-nowrap relative z-10">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/></svg>
              <span>Prazo improrrogável de defesa</span>
            </span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>

        <!-- Card 3: Rádio Comunitária (Radcom) -->
        <a 
