---
import Layout from '../../layouts/Layout.astro';
import { CONTACT_INFO } from '../../config';

const whatsappUrl = `https://wa.me/${CONTACT_INFO.whatsapp}?text=Ol%C3%A1%2C%20recebi%20uma%20notifica%C3%A7%C3%A3o%2Fauto%20da%20Anatel%20e%20preciso%20de%20assessoria%20urgente.`;
---

<Layout 
  title="Defesa administrativa Anatel | Autos e PADO | IMEA"
  description="Assessoria jurídica e técnica especializada em defesas contra autos de infração da Anatel, recursos de multas, PADO e fiscalização de radiodifusão."
  videoUrl="/videos/7087636-hd_1366_720_25fps.mp4"
>

  <!-- Hero Section com Camada 5 Editorial Typography -->
  <section class="relative bg-gradient-to-b from-[#06090e]/75 via-[#06090e]/50 to-[#06090e] text-white -mt-24 pt-32 pb-20 sm:pt-36 sm:pb-28 overflow-hidden border-b border-white/[0.08]">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 relative z-10">
      <div class="max-w-3xl space-y-6">
        <a href="/" class="text-sm font-mono font-bold uppercase tracking-wider text-red-400 hover:text-red-300 inline-flex items-center gap-2 transition-colors whitespace-nowrap">
          <span>←</span>
          <span>Voltar para Início</span>
        </a>
        
        <div class="editorial-eyebrow editorial-eyebrow-dark text-red-300 border-red-500/25 bg-red-950/40">
          <span class="telemetry-dot bg-red-400"></span>
          <span>Contencioso Especializado • PADO & Fiscalização</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight text-balance">
          <span class="title-liquid-platinum block">Defesa Administrativa contra</span>
          <span class="bg-gradient-to-r from-red-400 via-amber-400 to-orange-400 bg-clip-text text-transparent block mt-1.5">Autuações da Anatel</span>
        </h1>
        
        <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed text-pretty">
          Atuação tempestiva contra autos de infração, fiscalizações de sobrepotência, PADO e exigências técnicas. Protegemos sua concessão contra multas e sanções de interrupção do serviço.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
          <a 
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            data-magnetic
            class="btn-shimmer-auto inline-flex items-center justify-center gap-2.5 sm:gap-3 bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs sm:text-sm md:text-base uppercase tracking-wider px-6 sm:px-8 py-3.5 sm:py-4.5 rounded-2xl shadow-glow-red transition-all duration-300 transform hover:-translate-y-1 text-center whitespace-nowrap group shrink-0 border-t border-white/25"
          >
            <svg class="w-5 h-5 text-amber-200 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span>Plantão para Defesas Urgentes</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-24 sm:py-32 bg-white text-slate-900 relative">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16 items-start">
        
        <!-- Main Content Column -->
        <div class="lg:col-span-2 space-y-12">
          
          <div class="space-y-4">
            <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 text-balance">
              Prazos de Defesa perante a Anatel são Fatais
            </h2>
            <p class="text-slate-600 text-base leading-relaxed font-normal text-pretty">
              Ao receber um Termo de Notificação, Auto de Infração ou abertura de PADO (Processo de Apuração de Descumprimento de Obrigação), o radiodifusor dispõe de prazos exíguos (geralmente entre 10 e 30 dias). A ausência de manifestação tempestiva acarreta revelia e aplicação imediata de multas pecuniárias que podem inviabilizar a emissora.
            </p>
          </div>

          <div class="space-y-6">
            <h3 class="text-xl font-bold text-slate-900">Principais Infrações Defendidas</h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div 
                class="modern-card p-6 rounded-2xl border border-slate-200/90 bg-slate-50/50 space-y-2 relative overflow-hidden" 
                data-spotlight="red"
                data-tilt
                data-tilt-max="3.5"
              >
                <span class="telemetry-badge telemetry-badge-light text-red-800 bg-red-50 border border-red-200/90 relative z-10">
                  <span class="telemetry-dot bg-red-600"></span>
                  <span>Potência RF</span>
                </span>
                <h4 class="font-bold text-slate-900 text-base relative z-10">Excesso de Potência (25W ERP)</h4>
                <p class="text-slate-600 text-xs leading-relaxed font-normal relative z-10">Contestação de métodos de medição da fiscalização móvel com laudos técnicos de irradiação emitidos por engenheiros habilitados.</p>
              </div>

              <div 
                class="modern-card p-6 rounded-2xl border border-slate-200/90 bg-slate-50/50 space-y-2 relative overflow-hidden" 
                data-spotlight="red"
                data-tilt
                data-tilt-max="3.5"
              >
                <span class="telemetry-badge telemetry-badge-light text-red-800 bg-red-50 border border-red-200/90 relative z-10">
                  <span class="telemetry-dot bg-red-600"></span>
                  <span>Conformidade Técnica</span>
                </span>
                <h4 class="font-bold text-slate-900 text-base relative z-10">Irradiação de Espúrios</h4>
                <p class="text-slate-600 text-xs leading-relaxed font-normal relative z-10">Defesa técnica fundamentada em filtros de harmônicos e calibração homologada de transmissores.</p>
              </div>

              <div 
                class="modern-card p-6 rounded-2xl border border-slate-200/90 bg-slate-50/50 space-y-2 relative overflow-hidden" 
                data-spotlight="red"
                data-tilt
                data-tilt-max="3.5"
              >
                <span class="telemetry-badge telemetry-badge-light text-red-800 bg-red-50 border border-red-200/90 relative z-10">
                  <span class="telemetry-dot bg-red-600"></span>
                  <span>Parque Transmissor</span>
                </span>
                <h4 class="font-bold text-slate-900 text-base relative z-10">Mudança Não Autorizada de Local</h4>
                <p class="text-slate-600 text-xs leading-relaxed font-normal relative z-10">Regularização de coordenadas do parque transmissor e comprovação de ausência de dolo na alteração física.</p>
              </div>

              <div 
                class="modern-card p-6 rounded-2xl border border-slate-200/90 bg-slate-50/50 space-y-2 relative overflow-hidden" 
                data-spotlight="red"
                data-tilt
                data-tilt-max="3.5"
              >
                <span class="telemetry-badge telemetry-badge-light text-red-800 bg-red-50 border border-red-200/90 relative z-10">
                  <span class="telemetry-dot bg-red-600"></span>
                  <span>Razoabilidade</span>
                </span>
                <h4 class="font-bold text-slate-900 text-base relative z-10">Atraso em Obrigações Regulatórias</h4>
                <p class="text-slate-600 text-xs leading-relaxed font-normal relative z-10">Justificativas administrativas e redução ou anulação de penalidades com base na razoabilidade e proporcionalidade.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Sidebar CTA com Botão com Ícones Sem Quebra de Linha -->
        <div class="space-y-6 lg:sticky lg:top-28">
          <div 
            class="modern-card rounded-3xl p-7 border border-red-200/80 bg-slate-900 text-white space-y-6 relative overflow-hidden" 
            data-spotlight="red"
            data-tilt
            data-tilt-max="3"
          >
            <div class="space-y-2 relative z-10">
              <div class="editorial-eyebrow editorial-eyebrow-dark text-red-300 border-red-500/30 bg-red-950/50">
                <span class="telemetry-dot bg-red-400"></span>
                <span>Plantão Tempestivo</span>
              </div>
              <h3 class="text-xl font-black pt-2">Recebeu notificação da fiscalização?</h3>
            </div>
            <p class="text-slate-300 text-xs leading-relaxed relative z-10">
              Não perca o prazo legal de impugnação. Envie o auto para análise imediata da nossa equipe jurídica.
            </p>
            <div class="relative z-10">
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                data-magnetic
                class="btn-shimmer-auto w-full inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider px-4 py-3.5 sm:py-4 rounded-2xl shadow-glow-red transition-all duration-300 transform hover:-translate-y-0.5 text-center whitespace-nowrap group border-t border-white/25"
              >
                <svg class="w-4 h-4 text-amber-200 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Enviar Auto para Avaliação</span>
                <svg class="w-3.5 h-3.5 shrink-0 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
