---
import Layout from '../layouts/Layout.astro';
import { CONTACT_INFO } from '../config';

const whatsappUrl = `https://wa.me/${CONTACT_INFO.whatsapp}?text=Ol%C3%A1%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20os%20servi%C3%A7os%20da%20IMEA%20Radiodifus%C3%A3o.`;

const services = [
  {
    title: "Renovação de Outorga",
    category: "Processo Ministerial",
    description: "Requerimento administrativo perante o MCom dentro do prazo legal estrito (12 meses anteriores ao vencimento). Regularização no CADSE e instrução completa de certidões e laudos.",
    highlights: ["Monitoramento de prazo fatal no CADSE", "Laudos técnicos de engenharia", "Acompanhamento até decreto no DOU"],
    iconPath: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
    href: "/solucoes/renovacao-de-outorga",
    spotlight: "blue"
  },
  {
    title: "Defesa Administrativa Anatel",
    category: "Contencioso & PADO",
    description: "Impugnação técnica de autos de infração e processos administrativos (PADO). Defesa contra notificações por excesso de potência, antena irregular ou falta de laudo de conformidade.",
    highlights: ["Impugnação em 1ª e 2ª instâncias", "Análise de dosimetria de multas", "Defesa técnica de conformidade RF"],
    iconPath: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z",
    href: "/solucoes/defesa-administrativa-anatel",
    spotlight: "red"
  },
  {
    title: "Rádio Comunitária (Radcom)",
    category: "Associações & Fundações",
    description: "Assessoria completa para entidades comunitárias: habilitação em editais do PNO, regularização de diretoria, alteração estatutária e defesa contra denúncias ou encerramento de outorga.",
    highlights: ["Editais do PNO do MCom", "Estatutos e atas em cartório", "Orientação sobre Apoio Cultural"],
    iconPath: "M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z",
    href: "/radio-comunitaria",
    spotlight: "cyan"
  },
  {
    title: "Engenharia & Migração AM-FM",
    category: "Projetos Técnicos",
    description: "Coordenação de projetos de engenharia de radiofrequência: migração AM para FM estendida, aumento de potência, mudança de classe e laudos de conformidade com ART.",
    highlights: ["Migração para FM estendida (eFM)", "Aumento de classe e potência", "Laudos de irradiação e diagrama"],
    iconPath: "M13 2 3 14h9l-1 8 10-12h-9l1-8z",
    href: "/solucoes/consultoria-em-radiodifusao",
    spotlight: "indigo"
  },
  {
    title: "Contratos & Alterações Societárias",
    category: "Direito Regulatório",
    description: "Elaboração de contratos de arrendamento de programação, cessão de cotas e reformas estatutárias com aprovação prévia ou homologação junto ao MCom.",
    highlights: ["Aprovação prévia no Ministério", "Averbação de atas de diretoria", "Contratos de cessão e arrendamento"],
    iconPath: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z",
    href: "/solucoes/contratos-e-documentacao",
    spotlight: "emerald"
  },
  {
    title: "Auditoria Cadastral e Preventiva",
    category: "Compliance Regulatório",
    description: "Diagnóstico completo da situação cadastral e jurídica da emissora nos sistemas CADSE, SEI e Anatel. Identificação precoce de inconsistências antes que virem autuações.",
    highlights: ["Varredura nos sistemas federais", "Relatório de riscos e prazos", "Plano de regularização prioritária"],
    iconPath: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
    href: "/diagnostico-inicial",
    spotlight: "blue"
  }
];
---

<Layout 
  title="Serviços especializados em radiodifusão | IMEA"
  description="Renovação de outorgas, defesas Anatel, rádio comunitária, engenharia e contratos societários para emissoras de rádio e TV em todo o Brasil."
  videoUrl="/videos/7087636-hd_1366_720_25fps.mp4"
>

  <!-- Hero de Serviços com Camada 5 Editorial Typography -->
  <section class="relative bg-gradient-to-b from-[#06090e]/75 via-[#06090e]/50 to-[#06090e] text-white -mt-24 pt-32 pb-20 sm:pt-36 sm:pb-28 overflow-hidden border-b border-white/[0.08]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 relative z-10" data-animate="fade-up">
      <div class="editorial-eyebrow editorial-eyebrow-dark text-blue-300 border-blue-500/25">
        <span class="telemetry-dot bg-blue-400"></span>
        <span>Assessoria Integral em Radiodifusão</span>
      </div>
      
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight text-balance">
        <span class="title-liquid-platinum block">Soluções Especializadas para</span>
        <span class="title-liquid-cyan block mt-1.5">Emissoras de Rádio e TV</span>
      </h1>
      
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed text-pretty">
        Com mais de duas décadas de atuação exclusiva em Brasília, oferecemos segurança jurídica e técnica para sua emissora operar em total conformidade.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          data-magnetic
          class="btn-shimmer-auto inline-flex items-center justify-center gap-2.5 sm:gap-3 bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs sm:text-sm md:text-base uppercase tracking-wider px-6 sm:px-8 py-3.5 sm:py-4.5 rounded-2xl shadow-glow-blue transition-all duration-300 transform hover:-translate-y-1 text-center whitespace-nowrap group shrink-0 border-t border-white/25"
        >
          <svg class="w-5 h-5 text-cyan-300 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Falar com Consultor Regulatório</span>
          <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <a 
          href="/diagnostico-inicial" 
          data-magnetic
          class="btn-shimmer inline-flex items-center justify-center gap-2.5 bg-white/[0.08] hover:bg-white/[0.15] text-white text-center font-bold text-xs sm:text-sm md:text-base uppercase tracking-wider px-6 sm:px-8 py-3.5 sm:py-4.5 rounded-2xl border border-white/[0.18] backdrop-blur-md transition-all duration-200 whitespace-nowrap group shrink-0 border-t border-white/30"
        >
          <svg class="w-5 h-5 text-cyan-300 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span>Diagnóstico Inicial Grátis</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Lista de Serviços com Acabamento Especular, Spotlight e Tilt 3D -->
  <section class="py-20 sm:py-28 bg-white text-slate-900 relative">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 space-y-16">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <div 
            class="modern-card rounded-3xl p-8 border-t-2 border-t-blue-500 border-x border-slate-200/80 border-b border-slate-200/60 shadow-[0_1px_3px_rgba(15,23,42,0.03),0_12px_28px_-4px_rgba(15,23,42,0.05),inset_0_1px_0_rgba(255,255,255,1)] bg-white space-y-6 flex flex-col justify-between hover:border-blue-400 transition-all group overflow-hidden"
            data-spotlight={service.spotlight}
            data-tilt
            data-tilt-max="3.5"
          >
            <div class="space-y-4 relative z-10">
              <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d={service.iconPath} />
                </svg>
              </div>
              <div class="space-y-1.5">
                <span class="telemetry-badge telemetry-badge-light text-blue-800 bg-blue-50 border border-blue-200/90">
                  <span class="telemetry-dot bg-blue-600"></span>
                  <span>{service.category}</span>
                </span>
                <h2 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors tracking-tight">{service.title}</h2>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed font-normal">{service.description}</p>
              
              <div class="pt-2 border-t border-slate-100 space-y-2">
                {service.highlights.map(item => (
                  <div class="flex items-center gap-2 text-xs text-slate-600 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0"></span>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Botão com Ícone Padronizado Sem Quebra de Linha -->
            <div class="pt-4 border-t border-slate-100 relative z-10">
              <a 
                href={service.href} 
                class="btn-shimmer w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-slate-50 hover:bg-blue-600 text-blue-600 hover:text-white text-xs font-bold uppercase tracking-wider border border-slate-200 hover:border-blue-600 transition-all duration-200 group-hover:shadow-sm whitespace-nowrap"
              >
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                <span>Ver Detalhes do Serviço</span>
                <svg class="w-3.5 h-3.5 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA Box no Rodapé com Shimmer e Magnetic -->
  <section class="py-20 bg-slate-50 border-t border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <h2 class="text-3xl font-black text-slate-900 tracking-tight text-balance">Dúvidas sobre qual serviço a sua emissora necessita?</h2>
      <p class="text-slate-600 text-base max-w-xl mx-auto font-normal leading-relaxed text-pretty">
        Realizamos uma auditoria cadastral e jurídica preliminar da sua concessão sem custo para apontar o rito exato.
      </p>
      <div>
        <a 
          href="/diagnostico-inicial" 
          data-magnetic
          class="btn-shimmer-auto inline-flex items-center justify-center gap-2.5 sm:gap-3 bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs sm:text-sm md:text-base uppercase tracking-wider px-6 sm:px-8 py-3.5 sm:py-4.5 rounded-2xl shadow-glow-blue transition-all duration-300 transform hover:-translate-y-1 text-center whitespace-nowrap group shrink-0 border-t border-white/25"
        >
          <svg class="w-5 h-5 text-cyan-300 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Solicitar Diagnóstico Preliminar</span>
          <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
