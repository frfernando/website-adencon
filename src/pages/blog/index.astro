---
import Layout from '../../layouts/Layout.astro';
import { CONTACT_INFO } from '../../config';
import { BLOG_POSTS } from '../../data/blogPosts';

const whatsappUrl = `https://wa.me/${CONTACT_INFO.whatsapp}?text=Ol%C3%A1%2C%20estava%20lendo%20o%20Radar%20Regulat%C3%B3rio%20da%20IMEA%20Radiodifus%C3%A3o%20e%20gostaria%20de%20tirar%20uma%20d%C3%BAvida%20sobre%20minha%20emissora.`;

const featuredPost = BLOG_POSTS.find(p => p.featured) || BLOG_POSTS[0];
const standardPosts = BLOG_POSTS.filter(p => p.slug !== featuredPost.slug);

---

<Layout 
  title="Radar Regulatório | IMEA Radiodifusão e Telecomunicações"
  description="Artigos, análises de editais do MCom, prazos da Anatel, defesas de PADO e orientações jurídicas para emissoras de rádio e TV em todo o Brasil."
  videoUrl="/videos/7087636-hd_1366_720_25fps.mp4"
>

  <!-- Hero Editorial do Blog / Radar Regulatório -->
  <section class="relative bg-gradient-to-b from-[#06090e]/90 via-[#06090e]/75 to-[#06090e] text-white -mt-24 pt-32 pb-16 sm:pt-40 sm:pb-24 overflow-hidden border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 relative z-10">
      
      <!-- Eyebrow Editorial -->
      <div class="editorial-eyebrow editorial-eyebrow-dark text-amber-300 border-amber-500/30">
        <span class="telemetry-dot bg-amber-400"></span>
        <span>Radar Regulatório Federal • Atualizado 2026</span>
      </div>
      
      <!-- Título de Alto Valor -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight font-display">
        Orientações Técnicas e <span class="bg-gradient-to-r from-amber-300 via-orange-400 to-yellow-300 bg-clip-text text-transparent">Legislação MCom & Anatel</span>
      </h1>
      
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Análises fundamentadas por advogados regulatórios e engenheiros de telecomunicações para blindar sua emissora contra perempção, autos de infração e multas.
      </p>

      <div class="pt-2 flex justify-center">
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          data-magnetic
          class="btn-shimmer-auto inline-flex items-center justify-center gap-2.5 sm:gap-3 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs sm:text-sm uppercase tracking-wider px-6 sm:px-8 py-3.5 sm:py-4 rounded-full shadow-glow-blue transition-all duration-300 whitespace-nowrap group shrink-0"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-emerald-300 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"/>
          </svg>
          <span>Consultar Advogado Regulatório no WhatsApp</span>
          <svg class="w-4 h-4 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Seção de Conteúdo e Listagem de Artigos -->
  <section class="py-16 sm:py-24 bg-[#f8fafc] text-slate-900">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 space-y-14">
      
      <!-- Artigo em Destaque Principal (Featured Hero Card) -->
      {featuredPost && (
        <div class="space-y-4">
          <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-slate-500">
            <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span>Artigo em Destaque no Radar Regulatório</span>
          </div>

          <article class="modern-card rounded-3xl p-8 sm:p-10 lg:p-12 bg-white border border-slate-200 shadow-soft-md grid grid-cols-1 lg:grid-cols-12 gap-8 items-center group relative overflow-hidden">
            <div class="lg:col-span-8 space-y-5">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full bg-blue-500/10 text-blue-700 border border-blue-200">
                  <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                  {featuredPost.category}
                </span>
                <span class="text-xs font-mono text-slate-400">{featuredPost.date}</span>
                <span class="text-xs font-mono text-slate-400">• {featuredPost.readTime}</span>
              </div>

              <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors leading-tight font-display">
                <a href={`/blog/${featuredPost.slug}`}>
                  {featuredPost.title}
                </a>
              </h2>

              <p class="text-slate-600 text-base leading-relaxed font-normal">
                {featuredPost.description}
              </p>

              <!-- Mini Takeaways -->
              {featuredPost.keyTakeaways && (
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/70 space-y-1.5">
                  <span class="text-[11px] font-mono font-bold uppercase text-slate-500 block">Ponto Crítico:</span>
                  <p class="text-xs text-slate-700 leading-relaxed font-medium">
                    {featuredPost.keyTakeaways[0]}
                  </p>
                </div>
              )}

              <div class="pt-2 flex items-center justify-between flex-wrap gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center">
                    {featuredPost.author.charAt(0)}
                  </div>
                  <div class="text-xs">
                    <span class="font-bold text-slate-900 block">{featuredPost.author}</span>
                    <span class="text-slate-500">{featuredPost.authorRole}</span>
                  </div>
                </div>

                <a 
                  href={`/blog/${featuredPost.slug}`}
                  class="btn-shimmer inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold uppercase tracking-wider shadow-glow-blue transition-all whitespace-nowrap"
                >
                  <span>Ler Artigo Completo</span>
                  <span>→</span>
                </a>
              </div>
            </div>

            <!-- Coluna Visual / Ilustrativa Lateral do Destaque -->
            <div class="lg:col-span-4 bg-gradient-to-br from-[#0c121e] to-[#080d16] text-white p-6 sm:p-8 rounded-2xl border border-white/10 shadow-lg space-y-4 text-center">
              <div class="w-12 h-12 rounded-xl bg-blue-500/20 text-blue-400 mx-auto flex items-center justify-center border border-blue-400/30">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <h3 class="text-base font-bold text-white">Auditoria Regulatória</h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                Mais de 20 anos de experiência técnica em outorgas no MCom e Anatel. Atendimento individualizado.
              </p>
              <div class="pt-2 border-t border-white/10 text-[11px] font-mono text-cyan-300">
                Status: Plantão Ativo em Todo o Brasil
              </div>
            </div>
          </article>
        </div>
      )}

      <!-- Grade dos Demais Artigos -->
      <div class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <h2 class="text-lg font-bold text-slate-900 font-display">
            Todas as Publicações Técnicas
          </h2>
          <span class="text-xs font-mono text-slate-500">
            {BLOG_POSTS.length} orientações regulatórias disponíveis
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {standardPosts.map(post => (
            <article 
              data-tilt 
              data-tilt-max="3" 
              data-spotlight="blue"
              class="modern-card rounded-3xl p-7 sm:p-8 bg-white border border-slate-200 shadow-soft-sm flex flex-col justify-between hover:border-blue-300 transition-all group"
            >
              <div class="space-y-4">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <span class={`inline-flex items-center gap-1.5 text-[11px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border ${post.tagColor}`}>
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    {post.category}
                  </span>
                  <span class="text-xs font-mono text-slate-400">{post.readTime}</span>
                </div>
                
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug font-display">
                  <a href={`/blog/${post.slug}`}>
                    {post.title}
                  </a>
                </h3>
                
                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-normal line-clamp-3">
                  {post.description}
                </p>
              </div>

              <div class="pt-6 border-t border-slate-100 flex items-center justify-between gap-3 mt-6">
                <div class="text-xs">
                  <span class="font-semibold text-slate-800 block truncate max-w-[140px]">{post.author}</span>
                  <span class="text-[11px] font-mono text-slate-400 block">{post.date}</span>
                </div>

                <a 
                  href={`/blog/${post.slug}`} 
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 hover:text-blue-700 uppercase tracking-wider group-hover:translate-x-1 transition-transform whitespace-nowrap"
                >
                  <span>Ler Artigo</span>
                  <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA Box no Rodapé do Blog -->
  <section class="py-20 bg-[#0c1018] text-white border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-400/30 text-blue-300 font-mono text-xs font-bold uppercase tracking-wider">
        <span>Canal Oficial de Atendimento</span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display">
        Sua emissora tem uma situação específica perante o MCom ou Anatel?
      </h2>
      
      <p class="text-slate-300 text-base max-w-xl mx-auto font-normal leading-relaxed">
        Não hesite em falar conosco. Prestamos consultoria técnica e jurídica individualizada para concessionárias de radiodifusão em todo o território nacional.
      </p>

      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          data-magnetic
          class="btn-shimmer-auto inline-flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs sm:text-sm uppercase tracking-wider px-7 py-4 rounded-full shadow-glow-blue transition-all duration-300 whitespace-nowrap group shrink-0"
        >
          <svg class="w-4 h-4 fill-emerald-300 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"/>
          </svg>
          <span>Falar no WhatsApp com Nossos Especialistas</span>
          <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <a 
          href="/contato" 
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full bg-white/[0.08] hover:bg-white/[0.14] border border-white/15 text-slate-200 text-xs sm:text-sm font-bold transition-all whitespace-nowrap"
        >
          <span>Acessar Página de Contato</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
