---
import Layout from '../../layouts/Layout.astro';
import { CONTACT_INFO, SITE_METADATA } from '../../config';
import { BLOG_POSTS } from '../../data/blogPosts';

export function getStaticPaths() {
  return BLOG_POSTS.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const whatsappUrl = `https://wa.me/${CONTACT_INFO.whatsapp}?text=Ol%C3%A1%2C%20li%20o%20artigo%20sobre%20${encodeURIComponent(post.title)}%20e%20gostaria%20de%20uma%20orienta%C3%A7%C3%A3o%20especializada.`;
const currentUrl = new URL(`/blog/${post.slug}`, SITE_METADATA.url).toString();
const shareWhatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(post.title + ' - ' + currentUrl)}`;
const shareLinkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;

// Extrai cabeçalhos H2 para gerar automaticamente o Índice de Leitura dinâmico
const h2Regex = /<h2>(.*?)<\/h2>/g;
let match;
const headings: { id: string; title: string }[] = [];
let idx = 1;
let enrichedContent = post.content;

while ((match = h2Regex.exec(post.content)) !== null) {
  const fullMatch = match[0];
  const innerHtml = match[1];
  const cleanTitle = innerHtml.replace(/<[^>]*>?/gm, '');
  const id = `secao-${idx}`;
  headings.push({ id, title: cleanTitle });
  enrichedContent = enrichedContent.replace(fullMatch, `<h2 id="${id}">${innerHtml}</h2>`);
  idx++;
}

// Artigos relacionados sugeridos
const relatedPosts = BLOG_POSTS.filter(p => p.slug !== post.slug).slice(0, 2);

// Data ISO para schema.org (formato exibido: "02 Set, 2026")
const MESES: Record<string, string> = { Jan: '01', Fev: '02', Mar: '03', Abr: '04', Mai: '05', Jun: '06', Jul: '07', Ago: '08', Set: '09', Out: '10', Nov: '11', Dez: '12' };
const dm = post.date.match(/(\d{2})\s+(\w{3}),\s*(\d{4})/);
const datePublished = dm && MESES[dm[2]] ? `${dm[3]}-${MESES[dm[2]]}-${dm[1]}` : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  ...(datePublished ? { datePublished } : {}),
  inLanguage: 'pt-BR',
  articleSection: post.category,
  timeRequired: `PT${parseInt(post.readTime, 10)}M`,
  image: new URL('/og-imea-radiodifusao.png', SITE_METADATA.url).toString(),
  url: currentUrl,
  author: { '@type': 'Person', name: post.author, jobTitle: post.authorRole },
  publisher: {
    '@type': 'Organization',
    name: SITE_METADATA.brandName,
    legalName: CONTACT_INFO.companyName,
    logo: { '@type': 'ImageObject', url: new URL('/og-imea-radiodifusao.png', SITE_METADATA.url).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': currentUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE_METADATA.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Radar Regulatório', item: `${SITE_METADATA.url}/blog` },
    { '@type': 'ListItem', position: 3, name: post.title, item: currentUrl },
  ],
};
---

<Layout 
  title={`${post.title} | Radar Regulatório IMEA`}
  description={post.description}
  videoUrl="/videos/7087636-hd_1366_720_25fps.mp4"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero Editorial do Artigo -->
  <section class="relative bg-gradient-to-b from-[#06090e]/90 via-[#06090e]/75 to-[#06090e] text-white -mt-24 pt-32 pb-16 sm:pt-40 sm:pb-20 overflow-hidden border-b border-white/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      
      <!-- Breadcrumbs e Navegação -->
      <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs font-mono text-slate-400 flex-wrap">
        <a href="/" class="hover:text-cyan-300 transition-colors">Início</a>
        <span>/</span>
        <a href="/blog" class="hover:text-cyan-300 transition-colors">Radar Regulatório</a>
        <span>/</span>
        <span class="text-slate-200 truncate max-w-xs sm:max-w-md">{post.category}</span>
      </nav>

      <!-- Badge de Categoria e Metadados de Publicação -->
      <div class="flex items-center gap-3 flex-wrap">
        <span class={`inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full border backdrop-blur-md ${post.categoryColor}`}>
          <span class="w-2 h-2 rounded-full bg-current animate-pulse"></span>
          {post.category}
        </span>
        <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <time>{post.date}</time>
        </div>
        <span class="text-slate-600 text-xs hidden sm:inline">•</span>
        <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
          <svg class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{post.readTime}</span>
        </div>
      </div>

      <!-- Título Editorial Principal -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-[1.2] font-display">
        {post.title}
      </h1>

      <!-- Resumo do Artigo -->
      <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed max-w-4xl">
        {post.description}
      </p>

      <!-- Credencial do Especialista Autor -->
      <div class="pt-2 flex items-center gap-3.5 border-t border-white/10">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-black text-sm shadow-md border border-white/20 shrink-0">
          {post.author.charAt(0)}
        </div>
        <div>
          <div class="text-sm font-bold text-white leading-snug">{post.author}</div>
          <div class="text-xs font-mono text-slate-400">{post.authorRole} • OAB & Engenharia Consultiva</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Corpo Principal do Artigo com Estrutura de Leitura de Alta Performance -->
  <section class="py-14 sm:py-20 bg-[#f8fafc] text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 xl:gap-14 items-start">
        
        <!-- Coluna Principal (Conteúdo do Artigo) -->
        <article class="lg:col-span-8 space-y-10">
          
          <!-- Box: Dossiê Regulatório (Pontos Críticos em Destaque) -->
          {post.keyTakeaways && post.keyTakeaways.length > 0 && (
            <div class="rounded-2xl p-6 sm:p-8 bg-gradient-to-br from-amber-500/[0.07] via-amber-500/[0.03] to-transparent border border-amber-500/30 shadow-soft-sm space-y-4">
              <div class="flex items-center gap-2.5 text-xs font-mono font-bold uppercase tracking-wider text-amber-900">
                <div class="w-7 h-7 rounded-lg bg-amber-500/20 flex items-center justify-center shrink-0 border border-amber-500/30">
                  <svg class="w-4 h-4 text-amber-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                </div>
                <span>Dossiê Informativo: Pontos Críticos em Destaque</span>
              </div>
              <ul class="space-y-2.5 text-sm sm:text-base text-slate-800">
                {post.keyTakeaways.map((point: string) => (
                  <li class="flex items-start gap-3">
                    <span class="w-2 h-2 rounded-full bg-amber-600 mt-2 shrink-0"></span>
                    <span class="leading-relaxed">{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Corpo do Texto Formatado pelo Motor Editorial -->
          <div class="editorial-article-body bg-white p-7 sm:p-10 md:p-12 rounded-3xl border border-slate-200/90 shadow-soft-sm">
            <div set:html={enrichedContent} />
          </div>

          <!-- Barra de Compartilhamento e Ações -->
          <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200/90 shadow-soft-xs flex flex-col sm:flex-row items-center justify-between gap-4">
            <span class="text-xs font-mono font-bold text-slate-500 uppercase tracking-wider">
              Compartilhar esta orientação técnica:
            </span>
            <div class="flex items-center gap-2.5 flex-wrap">
              <a 
                href={shareWhatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 text-xs font-bold transition-all whitespace-nowrap group"
              >
                <svg class="w-4 h-4 fill-emerald-600 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"/>
                </svg>
                <span>WhatsApp</span>
              </a>

              <a 
                href={shareLinkedinUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-xs font-bold transition-all whitespace-nowrap"
              >
                <svg class="w-4 h-4 fill-blue-700 shrink-0" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.9 0-1.63.73-1.63 1.63 0 .9.73 1.63 1.63 1.63.9 0 1.63-.73 1.63-1.63 0-.9-.73-1.63-1.63-1.63Z"/></svg>
                <span>LinkedIn</span>
              </a>

              <button 
                type="button" 
                id="copy-link-btn"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 text-xs font-bold transition-all whitespace-nowrap"
                data-url={currentUrl}
              >
                <svg class="w-4 h-4 text-slate-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                <span id="copy-btn-text">Copiar Link</span>
              </button>
            </div>
          </div>

          <!-- Box de Autoridade do Autor com Contato Direto -->
          <div class="bg-white p-7 sm:p-9 rounded-3xl border border-slate-200/90 shadow-soft-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-700 to-indigo-600 flex items-center justify-center text-white font-black text-xl shadow-lg border-2 border-white shrink-0">
                {post.author.charAt(0)}
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-base font-extrabold text-slate-900">{post.author}</span>
                  <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-blue-100 text-blue-700">Autor Verificado</span>
                </div>
                <div class="text-xs font-medium text-slate-500 leading-snug">{post.authorRole}</div>
                <p class="text-xs text-slate-600 pt-1 leading-relaxed max-w-lg">
                  Mais de 20 anos assessorando concessionárias e emissoras de rádio e TV perante a Anatel e o Ministério das Comunicações em todo o Brasil.
                </p>
              </div>
            </div>
            <a 
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-5 py-3 rounded-xl shadow-glow-blue transition-all whitespace-nowrap shrink-0 w-full sm:w-auto justify-center"
            >
              <span>Consultar o Autor</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>

          <!-- CTA de Urgência Regulatória para Emissoras -->
          <div class="rounded-3xl p-8 sm:p-10 bg-[#0c1018] text-white border-t border-white/20 border-x border-white/10 border-b border-white/5 shadow-2xl space-y-6 text-center relative overflow-hidden">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-400/30 text-cyan-300 font-mono text-xs font-bold uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
              Plantão de Defesa & Outorgas
            </div>

            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white font-display">
              Sua emissora foi notificada ou o prazo dos 12 meses está correndo?
            </h2>

            <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto font-normal leading-relaxed">
              O tempo é preclusivo perante a Anatel e o Ministério das Comunicações. Não perca a concessão por inércia ou defesa genérica.
            </p>

            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                data-magnetic
                class="btn-shimmer-auto inline-flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs sm:text-sm uppercase tracking-wider px-7 py-4 rounded-full shadow-glow-blue transition-all duration-300 whitespace-nowrap group shrink-0 w-full sm:w-auto"
              >
                <svg class="w-4 h-4 fill-emerald-300 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"/>
                </svg>
                <span>Falar no WhatsApp Imediatamente</span>
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>

              <a 
                href="/diagnostico-inicial"
                class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full bg-white/[0.08] hover:bg-white/[0.14] border border-white/15 text-slate-200 text-xs sm:text-sm font-bold transition-all whitespace-nowrap w-full sm:w-auto"
              >
                <span>Solicitar Diagnóstico Preliminar Grátis</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </article>

        <!-- Coluna Lateral Fixa (Sticky Sidebar) -->
        <aside class="lg:col-span-4 space-y-8 lg:sticky lg:top-28">
          
          <!-- Box: Índice do Artigo com Jump Links -->
          {headings.length > 0 && (
            <div class="bg-white p-6 rounded-3xl border border-slate-200/90 shadow-soft-sm space-y-4">
              <div class="flex items-center gap-2 pb-3 border-b border-slate-100">
                <svg class="w-4 h-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="21" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/><line x1="21" y1="14" x2="3" y2="14"/><line x1="21" y1="18" x2="3" y2="18"/></svg>
                <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900">
                  Neste Artigo
                </h3>
              </div>
              <nav class="space-y-1.5 text-xs">
                {headings.map(h => (
                  <a 
                    href={`#${h.id}`}
                    class="block py-1.5 px-2.5 rounded-lg text-slate-600 hover:text-blue-600 hover:bg-blue-50 transition-colors font-medium leading-snug"
                  >
                    {h.title}
                  </a>
                ))}
              </nav>
            </div>
          )}

          <!-- Card de Plantão Regulatório -->
          <div class="rounded-3xl p-6 bg-gradient-to-br from-[#0c121e] to-[#080d16] text-white border border-white/10 shadow-lg space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-wider">Plantão Regulatório</span>
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
            </div>
            
            <h4 class="text-lg font-bold text-white leading-snug">
              Precisa de resposta rápida para a sua rádio?
            </h4>
            
            <p class="text-xs text-slate-300 leading-relaxed font-normal">
              Atendimento direto por advogados regulatórios e engenheiros especialistas em telecomunicações.
            </p>

            <div class="pt-2 space-y-2.5">
              <a 
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-shimmer w-full inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-3 px-4 rounded-xl shadow-glow-blue transition-all whitespace-nowrap"
              >
                <span>Falar com o Plantão no WhatsApp</span>
                <span>→</span>
              </a>

              <a 
                href={`tel:${CONTACT_INFO.phone.replace(/[^0-9]/g, '')}`}
                class="w-full inline-flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 text-slate-200 border border-white/10 font-mono text-xs py-2.5 px-4 rounded-xl transition-all whitespace-nowrap"
              >
                <svg class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>{CONTACT_INFO.phone}</span>
              </a>
            </div>

            <div class="pt-2 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-slate-400">
              <span>Sede: Pres. Prudente - SP</span>
              <span>Experiência desde 2003</span>
            </div>
          </div>

          <!-- Leituras Complementares Recomendadas -->
          {relatedPosts.length > 0 && (
            <div class="bg-white p-6 rounded-3xl border border-slate-200/90 shadow-soft-sm space-y-4">
              <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 pb-2 border-b border-slate-100">
                Orientações Recomendadas
              </h3>
              <div class="space-y-4">
                {relatedPosts.map(rel => (
                  <a 
                    href={`/blog/${rel.slug}`} 
                    class="block group space-y-1.5 p-2 -mx-2 rounded-xl hover:bg-slate-50 transition-colors"
                  >
                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-blue-600 block">
                      {rel.category}
                    </span>
                    <h4 class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug line-clamp-2">
                      {rel.title}
                    </h4>
                    <span class="text-[11px] font-mono text-slate-400 block">{rel.readTime}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

        </aside>

      </div>
    </div>
  </section>

</Layout>

<script>
  // Script para o botão de copiar link com feedback instantâneo
  function setupCopyLink() {
    const btn = document.getElementById('copy-link-btn');
    const label = document.getElementById('copy-btn-text');
    if (btn && label) {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          label.textContent = 'Link Copiado!';
          btn.classList.add('bg-emerald-100', 'text-emerald-800', 'border-emerald-300');
          setTimeout(() => {
            label.textContent = 'Copiar Link';
            btn.classList.remove('bg-emerald-100', 'text-emerald-800', 'border-emerald-300');
          }, 2500);
        } catch (err) {
          console.error('Falha ao copiar:', err);
        }
      });
    }
  }

  setupCopyLink();
  document.addEventListener('astro:page-load', setupCopyLink);
</script>
