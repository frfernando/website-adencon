---
import { CONTACT_INFO } from '../config';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const whatsappUrl = `https://wa.me/${CONTACT_INFO.whatsapp}?text=Ol%C3%A1%2C%20gostaria%20de%20um%20atendimento%20especializado%20para%20minha%20emissora.`;

const solutions = [
  {
    name: "Renovação de Outorga",
    desc: "MCom, CADSE e rito dos 12 meses",
    href: "/solucoes/renovacao-de-outorga",
    type: "shield",
    badgeColor: "bg-blue-500/10 text-blue-400 border-blue-400/25 group-hover/item:bg-blue-600 group-hover/item:text-white"
  },
  {
    name: "Defesa Administrativa Anatel",
    desc: "Impugnação de PADO, fiscalização e multas",
    href: "/solucoes/defesa-administrativa-anatel",
    type: "alert",
    badgeColor: "bg-red-500/10 text-red-400 border-red-400/25 group-hover/item:bg-red-600 group-hover/item:text-white"
  },
  {
    name: "Rádio Comunitária (Radcom)",
    desc: "Editais do PNO e Lei nº 9.612/98",
    href: "/radio-comunitaria",
    type: "radio",
    badgeColor: "bg-cyan-500/10 text-cyan-400 border-cyan-400/25 group-hover/item:bg-cyan-600 group-hover/item:text-white"
  },
  {
    name: "Consultoria Técnica & RF",
    desc: "Migração AM-FM e aumento de potência",
    href: "/solucoes/consultoria-em-radiodifusao",
    type: "rf",
    badgeColor: "bg-indigo-500/10 text-indigo-400 border-indigo-400/25 group-hover/item:bg-indigo-600 group-hover/item:text-white"
  },
  {
    name: "Contratos & Societário",
    desc: "Arrendamento, atas e cotas no MCom",
    href: "/solucoes/contratos-e-documentacao",
    type: "contracts",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-400/25 group-hover/item:bg-emerald-600 group-hover/item:text-white"
  }
];
---

<!-- Cabeçalho Principal (Borda Superior e Inferior Removidas Conforme Solicitado) -->
<header
  class="site-header-light sticky top-0 z-[70] w-full bg-white/95 backdrop-blur-xl shadow-[0_4px_24px_-2px_rgba(15,23,42,0.12)] transition-all duration-300"
>
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex items-center justify-between h-20 sm:h-22">

      <!-- Identidade visual da marca (WebP responsivo de alta performance) -->
      <a href="/" class="flex items-center group py-2" aria-label="IMEA Radiodifusão - Página Inicial">
        <picture>
          <source
            type="image/webp"
            srcset="/logo-imea-radiodifusao-header-sm.webp 240w, /logo-imea-radiodifusao-header.webp 352w"
            sizes="(max-width: 640px) 120px, 176px"
          />
          <img
            src="/logo-imea-radiodifusao-header.webp"
            alt="IMEA Radiodifusão"
            class="w-[120px] sm:w-[152px] md:w-[176px] h-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
            width="176"
            height="91"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </a>

      <!-- Desktop Navigation Links com Iconografia Completa -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-[13px] xl:text-[14px] font-medium text-slate-300">

        <!-- Início -->
        <a
          href="/"
          class={`flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap ${currentPath === '/' ? 'text-white bg-white/10 font-bold border-t border-white/20' : 'hover:text-white hover:bg-white/5'}`}
        >
          <svg class="w-4 h-4 text-blue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Início</span>
        </a>

        <!-- Dropdown Soluções -->
        <div class="relative group/dropdown py-2">
          <button
            type="button"
            class={`flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap focus:outline-none ${currentPath.startsWith('/solucoes') ? 'text-white bg-white/10 font-bold border-t border-white/20' : 'hover:text-white hover:bg-white/5'}`}
            aria-expanded="false"
          >
            <svg class="w-4 h-4 text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <span>Soluções</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover/dropdown:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
          </button>

          <!-- Dropdown Card com Vidro Especular Inset e Largura Ampla Não Quebrada (390px) -->
          <div class="absolute top-full left-0 w-[390px] pt-2 opacity-0 invisible translate-y-2 group-hover/dropdown:opacity-100 group-hover/dropdown:visible group-hover/dropdown:translate-y-0 transition-all duration-200 pointer-events-none group-hover/dropdown:pointer-events-auto z-50">
            <div class="rounded-2xl p-2.5 bg-[#0c1018]/95 backdrop-blur-2xl border-t border-white/25 border-x border-white/10 border-b border-white/5 shadow-[0_20px_50px_rgba(0,0,0,0.7)] space-y-1">
              {solutions.map(sol => (
                <a
                  href={sol.href}
                  class="flex items-center gap-3.5 p-3 rounded-xl hover:bg-white/10 transition-all group/item"
                >
                  <div class={`w-10 h-10 rounded-xl border flex items-center justify-center shrink-0 transition-all duration-200 ${sol.badgeColor} group-hover/item:scale-105`}>
                    {sol.type === 'shield' && (
                      <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        <path d="m9 12 2 2 4-4"/>
                      </svg>
                    )}
                    {sol.type === 'alert' && (
                      <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                      </svg>
                    )}
                    {sol.type === 'radio' && (
                      <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z"/>
                      </svg>
                    )}
                    {sol.type === 'rf' && (
                      <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                      </svg>
                    )}
                    {sol.type === 'contracts' && (
                      <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                      </svg>
                    )}
                  </div>
                  <div class="space-y-0.5 min-w-0 flex-1">
                    <strong class="text-xs sm:text-[13px] text-white font-bold block group-hover/item:text-blue-300 transition-colors whitespace-nowrap">{sol.name}</strong>
                    <span class="text-[11px] text-slate-400 block leading-tight truncate">{sol.desc}</span>
                  </div>
                  <svg class="w-3.5 h-3.5 text-slate-500 group-hover/item:text-blue-400 group-hover/item:translate-x-1 transition-all shrink-0 ml-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M9 18l6-6-6-6"/>
                  </svg>
                </a>
              ))}
              <div class="pt-2 border-t border-white/10 mt-1">
                <a
                  href="/servicos"
                  class="flex items-center justify-between px-3 py-2 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 transition-colors rounded-lg hover:bg-cyan-500/10"
                >
                  <span>Ver todas as soluções</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Sobre a IMEA Radiodifusão -->
        <a
          href="/sobre"
          class={`flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap ${currentPath === '/sobre' ? 'text-white bg-white/10 font-bold border-t border-white/20' : 'hover:text-white hover:bg-white/5'}`}
        >
          <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          <span>Sobre a IMEA Radiodifusão</span>
        </a>

        <!-- Radar Regulatório / Blog -->
        <a
          href="/blog"
          class={`flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap ${currentPath.startsWith('/blog') ? 'text-white bg-white/10 font-bold border-t border-white/20' : 'hover:text-white hover:bg-white/5'}`}
        >
          <svg class="w-4 h-4 text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
          <span>Radar Regulatório</span>
        </a>

        <!-- Contato -->
        <a
          href="/contato"
          class={`flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all whitespace-nowrap ${currentPath === '/contato' ? 'text-white bg-white/10 font-bold border-t border-white/20' : 'hover:text-white hover:bg-white/5'}`}
        >
          <svg class="w-4 h-4 text-indigo-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Contato</span>
        </a>
      </nav>

      <!-- Right Action CTA Button WhatsApp com Ícone Oficial & Shimmer Sweep -->
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="WhatsApp — Header"
          class="btn-shimmer inline-flex items-center gap-2.5 bg-blue-600 hover:bg-blue-500 text-white text-[13px] sm:text-[14px] font-bold px-4 sm:px-5 py-2 sm:py-2.5 rounded-full shadow-glow-blue border-t border-white/25 border-x border-blue-400/30 border-b border-blue-600 transition-all duration-200 whitespace-nowrap group"
        >
          <svg class="w-4 h-4 fill-emerald-300 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"/>
          </svg>
          <span class="hidden sm:inline">Falar no WhatsApp</span>
          <span class="sm:hidden">WhatsApp</span>
          <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <button
          id="theme-toggle"
          type="button"
          class="theme-toggle inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white p-0 text-slate-700 shadow-sm transition-colors hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700 sm:h-11 sm:w-11"
          aria-label="Ativar modo escuro"
          aria-pressed="false"
        >
          <svg data-theme-icon="sun" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
          <svg data-theme-icon="moon" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.7 6.7 0 0 0 21 12.8Z"/></svg>
        </button>

        <!-- Mobile Menu Trigger com Ícone Hamburger e Fechar (X) -->
        <button
          id="mobile-menu-trigger"
          type="button"
          class="lg:hidden p-2.5 text-slate-300 hover:text-white rounded-xl hover:bg-white/10 focus:outline-none transition-colors"
          aria-label="Alternar menu de navegação"
          aria-expanded="false"
        >
          <!-- Ícone Aberto (3 barras) -->
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <!-- Ícone Fechado (X) -->
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer (Desdobrável com Animação e Ícones) -->
  <div
    id="mobile-menu-drawer"
    class="hidden lg:hidden bg-[#0a0d16]/98 border-t border-white/10 backdrop-blur-2xl px-4 pt-3 pb-6 space-y-3"
  >
    <div class="space-y-1 text-sm font-medium">
      <a
        href="/"
        class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-colors ${currentPath === '/' ? 'text-white bg-blue-600/20 font-bold text-blue-400' : 'text-slate-200 hover:bg-white/10'}`}
      >
        <svg class="w-4 h-4 text-blue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>Início</span>
      </a>

      <div class="space-y-1">
        <a
          href="/servicos"
          class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-200 hover:bg-white/10 transition-colors font-bold text-white"
        >
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <span>Soluções Regulatórias</span>
          </div>
          <span class="text-xs text-blue-400 font-semibold">Ver todas →</span>
        </a>
        <div class="pl-3 space-y-1 border-l border-white/10 ml-5 my-1">
          {solutions.map(sol => (
            <a
              href={sol.href}
              class="flex items-center gap-2 py-2 text-xs text-slate-300 hover:text-white transition-colors"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              <span>{sol.name}</span>
            </a>
          ))}
        </div>
      </div>

      <a
        href="/sobre"
        class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-colors ${currentPath === '/sobre' ? 'text-white bg-blue-600/20 font-bold text-blue-400' : 'text-slate-200 hover:bg-white/10'}`}
      >
        <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        <span>Sobre Nós</span>
      </a>

      <a
        href="/blog"
        class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-colors ${currentPath.startsWith('/blog') ? 'text-white bg-blue-600/20 font-bold text-blue-400' : 'text-slate-200 hover:bg-white/10'}`}
      >
        <svg class="w-4 h-4 text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
        <span>Radar Regulatório</span>
      </a>

      <a
        href="/contato"
        class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-colors ${currentPath === '/contato' ? 'text-white bg-blue-600/20 font-bold text-blue-400' : 'text-slate-200 hover:bg-white/10'}`}
      >
        <svg class="w-4 h-4 text-indigo-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>Contato</span>
      </a>
    </div>

    <div class="pt-2 border-t border-white/10">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-3 rounded-xl shadow-lg transition-colors text-sm"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"/>
        </svg>
        <span>Falar no WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  let headerCleanup: (() => void) | null = null;

  function initHeaderControls() {
    headerCleanup?.();

    const controller = new AbortController();
    const { signal } = controller;

    const trigger = document.getElementById('mobile-menu-trigger');
    const drawer = document.getElementById('mobile-menu-drawer');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (trigger && drawer && iconOpen && iconClose) {
      trigger.addEventListener('click', () => {
        const isOpen = !drawer.classList.contains('hidden');
        if (isOpen) {
          drawer.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          drawer.classList.remove('hidden');
          iconOpen.classList.add('hidden');
          iconClose.classList.remove('hidden');
          trigger.setAttribute('aria-expanded', 'true');
        }
      }, { signal });
    }

    const themeToggle = document.getElementById('theme-toggle');
    const sunIcon = document.querySelector('[data-theme-icon="sun"]');
    const moonIcon = document.querySelector('[data-theme-icon="moon"]');

    const syncThemeUI = (theme: 'dark' | 'light') => {
      const isDark = theme === 'dark';
      document.documentElement.classList.toggle('dark', isDark);
      document.documentElement.setAttribute('data-theme', theme);
      themeToggle?.setAttribute('aria-label', isDark ? 'Ativar modo claro' : 'Ativar modo escuro');
      themeToggle?.setAttribute('aria-pressed', isDark ? 'true' : 'false');
      sunIcon?.classList.toggle('hidden', !isDark);
      moonIcon?.classList.toggle('hidden', isDark);
    };

    const savedTheme = (localStorage.getItem('sanb-theme') as 'dark' | 'light' | null) ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    syncThemeUI(savedTheme);

    themeToggle?.addEventListener('click', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
      localStorage.setItem('sanb-theme', nextTheme);
      syncThemeUI(nextTheme);
      window.dispatchEvent(new CustomEvent('sanb-theme-change', { detail: { theme: nextTheme } }));
    }, { signal });

    headerCleanup = () => controller.abort();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderControls);
  } else {
    initHeaderControls();
  }

  document.addEventListener('astro:page-load', initHeaderControls);
</script>
