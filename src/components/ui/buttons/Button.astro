---
export interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'glow' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  disabled = false,
} = Astro.props;

const sizeStyles: Record<string, string> = {
  sm: 'px-3 py-1.5 text-xs rounded-lg gap-1.5',
  md: 'px-5 py-2.5 text-sm rounded-xl gap-2',
  lg: 'px-7 py-3.5 text-base rounded-2xl gap-2.5 font-bold',
};
const sizeClasses = sizeStyles[size];

const variantStyles: Record<string, string> = {
  primary: 'bg-emerald-500 text-neutral-950 font-semibold shadow-md shadow-emerald-500/20 hover:bg-emerald-400 focus:ring-emerald-400',
  secondary: 'bg-neutral-800 text-white font-medium hover:bg-neutral-700 border border-neutral-700 focus:ring-neutral-500',
  outline: 'bg-transparent text-white font-medium border border-neutral-700 hover:border-neutral-500 hover:bg-neutral-900 focus:ring-neutral-400',
  ghost: 'bg-transparent text-neutral-400 hover:text-white hover:bg-neutral-900 focus:ring-neutral-400',
  glow: 'bg-gradient-to-r from-emerald-400 to-cyan-400 text-neutral-950 font-bold shadow-lg shadow-emerald-500/30 hover:opacity-95 focus:ring-emerald-300',
  danger: 'bg-red-600 text-white font-semibold hover:bg-red-500 shadow-md shadow-red-600/20 focus:ring-red-400',
};
const variantClasses = variantStyles[variant];

const baseClasses = 'inline-flex items-center justify-center transition duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-neutral-950 active:scale-[0.98] disabled:opacity-50 disabled:pointer-events-none cursor-pointer';

const finalClasses = `${baseClasses} ${sizeClasses} ${variantClasses} ${className}`;
---

{
  href ? (
    <a href={href} class={finalClasses}>
      <slot />
    </a>
  ) : (
    <button type={type} disabled={disabled} class={finalClasses}>
      <slot />
    </button>
  )
}
