---
import { CONTACT_INFO } from '../config';

const whatsappUrl = `https://api.whatsapp.com/send?phone=${CONTACT_INFO.whatsapp}&text=Ol%C3%A1%2C%20estou%20no%20site%20da%20IMEA%20Radiodifus%C3%A3o%20e%20gostaria%20de%20um%20atendimento.`;
---

<div class="fixed bottom-24 right-4 md:bottom-6 md:right-6 z-50 flex items-center group print:hidden">
  <!-- Interactive tooltip -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mr-3 px-3.5 py-1.5 rounded-full bg-[#0c121e]/90 text-white font-mono text-[11px] font-bold border border-white/[0.1] shadow-2xl backdrop-blur-xl opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 pointer-events-none hidden sm:block whitespace-nowrap"
  >
    <span class="flex items-center gap-1.5 whitespace-nowrap">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      Plantão Regulatório Online
    </span>
  </a>

  <!-- Floating Button with Magnetic Physics & Pulse Glow -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    data-magnetic
    data-umami-event="WhatsApp — Flutuante"
    aria-label="Falar pelo WhatsApp com a IMEA Radiodifusão"
    class="relative w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-gradient-to-tr from-emerald-600 via-emerald-500 to-teal-400 text-white flex items-center justify-center shadow-glow-emerald border border-emerald-300/40 hover:scale-105 active:scale-95 transition-all duration-300 focus:outline-none shrink-0"
  >
    <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-400 border-2 border-[#06090e]"></span>
    </span>
    
    <svg class="w-6 h-6 md:w-7 md:h-7 fill-current shrink-0" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </a>
</div>
